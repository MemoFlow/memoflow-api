# MemoFlow database schema — derived from docs/database-schema.md (source of truth).
# Render: d2 database-schema.d2 database-schema.svg
# Solid edges = real FKs (PostgreSQL). Dashed edges = cross-DB uuid references,
# validated by the application use-case layer — there is NO foreign key across DBs.

direction: right

pg: PostgreSQL (primary — TypeORM, migrations only) {
  users: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    email: varchar {constraint: unique}
    password_hash: varchar
    display_name: varchar
    role: varchar
    xp: int
    level: int
    last_active_at: timestamptz
  }

  documents: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    user_id: uuid {constraint: foreign_key}
    title: varchar
    doc_type: varchar
    status: varchar
    style_config: jsonb
    created_at: timestamptz
    updated_at: timestamptz
  }

  # order indexed via composite (document_id, order) — IDX_sections_document_order.
  sections: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    document_id: uuid {constraint: foreign_key}
    title: varchar
    content: text
    order: int
    status: varchar
    word_count: int
    created_at: timestamptz
    updated_at: timestamptz
  }

  # section_id/user_id plain indexes are a deliberate addition beyond the original
  # design (item 5) — both are FK lookup paths on every suggestions call.
  ai_suggestions: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    section_id: uuid {constraint: foreign_key}
    user_id: uuid {constraint: foreign_key}
    feature_type: varchar
    original_text: text
    suggested_text: text
    status: varchar
    prompt_version: varchar
    created_at: timestamptz
    updated_at: timestamptz
  }

  # No public controller — repository-internal active-prompt lookup, seeded via
  # scripts/seed.ts.
  prompts: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    feature_type: varchar
    version: varchar
    template: text
    is_active: boolean
    created_at: timestamptz
    updated_at: timestamptz
  }

  # No provider tokens — Composio is the OAuth vault + MCP host; this API keeps only
  # a connection reference. Unique composite index on (user_id, provider).
  connector_connections: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    user_id: uuid {constraint: foreign_key}
    provider: varchar
    composio_account_id: "varchar (nullable)"
    status: varchar
    connected_at: "timestamptz (nullable)"
    created_at: timestamptz
    updated_at: timestamptz
  }

  # Unique composite index (user_id, document_id, milestone_type) —
  # IDX_milestones_user_document_type — the idempotent-award guard
  # awardOnce()'s ON CONFLICT DO NOTHING relies on.
  milestones: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    user_id: uuid {constraint: foreign_key}
    document_id: uuid {constraint: foreign_key}
    milestone_type: varchar
    xp_awarded: int
    created_at: timestamptz
  }

  daily_missions: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    code: varchar
    description: varchar
    xp_reward: int
    criteria: "jsonb ({ event, target })"
    active_date: date
    created_at: timestamptz
  }

  # Unique composite index (user_id, mission_id) — IDX_mission_progress_user_mission
  # — one progress row per (user, mission); incrementAtomic() upserts against it.
  mission_progress: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    user_id: uuid {constraint: foreign_key}
    mission_id: uuid {constraint: foreign_key}
    progress: int
    completed: boolean
    created_at: timestamptz
    updated_at: timestamptz
  }

  templates: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    title: varchar
    doc_type: varchar
    scope: varchar
    created_by: "uuid (nullable)" {constraint: foreign_key}
    style_config: jsonb
    is_published: boolean
    created_at: timestamptz
    updated_at: timestamptz
  }

  # order indexed via composite (template_id, order) — IDX_template_sections_template_order.
  template_sections: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    template_id: uuid {constraint: foreign_key}
    title: varchar
    order: int
    word_count_min: int
    word_count_max: int
    is_required: boolean
  }

  document_templates: {
    shape: sql_table
    id: uuid {constraint: primary_key}
    document_id: uuid {constraint: foreign_key}
    template_id: uuid {constraint: foreign_key}
    applied_at: timestamptz
    customised: boolean
  }

  documents.user_id -> users.id: cascade
  sections.document_id -> documents.id: cascade
  ai_suggestions.section_id -> sections.id
  ai_suggestions.user_id -> users.id
  connector_connections.user_id -> users.id
  milestones.user_id -> users.id: cascade
  milestones.document_id -> documents.id: cascade
  mission_progress.user_id -> users.id: cascade
  mission_progress.mission_id -> daily_missions.id: cascade
  templates.created_by -> users.id: set null
  template_sections.template_id -> templates.id: cascade
  document_templates.document_id -> documents.id: cascade
  document_templates.template_id -> templates.id: cascade
}

mongo: MongoDB (specialist — Mongoose) {
  # Unique compound index (document_id, version) — closes the concurrent-save
  # version race; repository create() retries once on duplicate-key.
  document_versions: {
    shape: sql_table
    _id: ObjectId {constraint: primary_key}
    document_id: "uuid (string)"
    user_id: "uuid (string)"
    version: int
    "label": "string?"
    sections_snapshot: "array (embedded: title, content, order, status, word_count)"
    saved_at: date
  }

  # document_id/section_id validated (caller-owned document; section belongs to it)
  # and bound at submission time by SubmitPlanningJobUseCase (item 5); both stay
  # null when the caller submits a job without a binding.
  planning_jobs: {
    shape: sql_table
    _id: ObjectId {constraint: primary_key}
    user_id: "uuid (string)"
    document_id: "uuid (string)?"
    section_id: "uuid (string)?"
    status: string
    prompt: string
    connectors: "string[] (unused until item 7)"
    prompt_version: "string? (recorded once the job runs)"
    context_used: "object? (recorded once the job runs)"
    result: object
    error_code: "string?"
    error_message: "string?"
    created_at: date
    started_at: date
    finished_at: date
    chunk_sequences: "number[] (RabbitMQ transport idempotency guard, [] otherwise)"
    data_chunks: "object[] (RabbitMQ transport: sequence, provider, content, token_estimate)"
  }
}

# Cross-DB references: plain uuids, validated by use-cases — no FK enforcement.
mongo.document_versions.document_id -> pg.documents.id: app-validated {style.stroke-dash: 4}
mongo.document_versions.user_id -> pg.users.id: app-validated {style.stroke-dash: 4}
mongo.planning_jobs.user_id -> pg.users.id: app-validated {style.stroke-dash: 4}
mongo.planning_jobs.document_id -> pg.documents.id: app-validated {style.stroke-dash: 4}
mongo.planning_jobs.section_id -> pg.sections.id: app-validated {style.stroke-dash: 4}
