{
  "openapi": "3.0.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Liveness check for PostgreSQL, MongoDB, and Redis",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Email is already registered"
          }
        },
        "summary": "Register a new user",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "summary": "Log in and receive a JWT access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/users/me": {
      "get": {
        "operationId": "UsersController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get the authenticated user",
        "tags": [
          "users"
        ]
      }
    },
    "/users/{id}": {
      "get": {
        "operationId": "UsersController_getById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a user by id",
        "tags": [
          "users"
        ]
      }
    },
    "/planning-jobs": {
      "post": {
        "operationId": "PlanningJobsController_submit",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitPlanningJobDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanningJobResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Failed to enqueue the job for processing"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Submit a planning job for async processing",
        "tags": [
          "planning-jobs"
        ]
      }
    },
    "/planning-jobs/{id}": {
      "get": {
        "operationId": "PlanningJobsController_getById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanningJobResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Planning job not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a planning job by id (REST fallback)",
        "tags": [
          "planning-jobs"
        ]
      }
    },
    "/connectors/{provider}/connect": {
      "post": {
        "operationId": "ConnectorsController_connect",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "trello",
                "notion",
                "github"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitiateConnectionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Unknown provider"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Composio failed to create a connect link"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Start a Composio connect flow for a provider",
        "tags": [
          "connectors"
        ]
      }
    },
    "/connectors": {
      "get": {
        "operationId": "ConnectorsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConnectorResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List the current user's connector connections",
        "tags": [
          "connectors"
        ]
      }
    },
    "/connectors/{id}": {
      "get": {
        "operationId": "ConnectorsController_getById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Connector connection not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a connector connection by id (owner-scoped)",
        "tags": [
          "connectors"
        ]
      },
      "delete": {
        "operationId": "ConnectorsController_revoke",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Connection revoked"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Connector connection not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoke a connector connection (owner-scoped)",
        "tags": [
          "connectors"
        ]
      }
    }
  },
  "info": {
    "title": "MemoFlow API",
    "description": "REST API for MemoFlow — users, documents, AI, connectors",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery-staple",
            "minLength": 8
          },
          "display_name": {
            "type": "string",
            "example": "Ada Lovelace"
          }
        },
        "required": [
          "email",
          "password",
          "display_name"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "xp": {
            "type": "number"
          },
          "level": {
            "type": "number"
          },
          "last_active_at": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "xp",
          "level",
          "last_active_at"
        ]
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery-staple"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "SubmitPlanningJobDto": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "example": "Draft an outline for chapter 3"
          },
          "connectors": {
            "example": [
              "notion",
              "github"
            ],
            "description": "Connector ids to gather context from (unused until roadmap item 7).",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "prompt"
        ]
      },
      "PlanningJobResponseDto": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "connectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "type": "object",
            "nullable": true
          },
          "error_code": {
            "type": "object",
            "nullable": true
          },
          "error_message": {
            "type": "object",
            "nullable": true
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "started_at": {
            "type": "object",
            "nullable": true
          },
          "finished_at": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "job_id",
          "status",
          "prompt",
          "connectors",
          "result",
          "error_code",
          "error_message",
          "created_at",
          "started_at",
          "finished_at"
        ]
      },
      "InitiateConnectionResponseDto": {
        "type": "object",
        "properties": {
          "redirect_url": {
            "type": "string",
            "description": "Composio's hosted connect URL to redirect the user to."
          },
          "connection_id": {
            "type": "string",
            "description": "Id of the `connector_connections` row."
          },
          "status": {
            "type": "string",
            "enum": [
              "initiated",
              "active",
              "revoked",
              "failed"
            ]
          }
        },
        "required": [
          "redirect_url",
          "connection_id",
          "status"
        ]
      },
      "ConnectorResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "trello",
              "notion",
              "github"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "initiated",
              "active",
              "revoked",
              "failed"
            ]
          },
          "connected_at": {
            "type": "object",
            "nullable": true
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "status",
          "connected_at",
          "created_at"
        ]
      }
    }
  }
}