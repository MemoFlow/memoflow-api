#!/usr/bin/env bash
# Rejects pushing a branch whose name is not a Conventional-Commit branch name.
# Mirrors .github/workflows/branch-naming.yml so failures surface before CI.
#
# Install once per clone:  bash scripts/install-hooks.sh
set -euo pipefail

allowed='^(feat|feature|fix|bugfix|hotfix|docs|refactor|perf|test|build|ci|chore|style|revert)/[a-z0-9._-]+$'
longlived='^(development|staging|main)$'

fail=0
while read -r local_ref _local_sha _remote_ref _remote_sha; do
  # Only inspect branch pushes (skip tags, deletes).
  case "$local_ref" in
    refs/heads/*) branch="${local_ref#refs/heads/}" ;;
    *) continue ;;
  esac

  if [[ "$branch" =~ $longlived || "$branch" =~ $allowed ]]; then
    continue
  fi

  echo "pre-push: '$branch' is not a conventional branch name." >&2
  echo "  Use '<type>/<slug>' where <type> is one of:" >&2
  echo "  feat fix hotfix docs refactor perf test build ci chore style revert" >&2
  fail=1
done

if [[ "$fail" -ne 0 ]]; then
  echo "pre-push: push rejected. Rename with: git branch -m <type>/<slug>" >&2
  exit 1
fi
exit 0
