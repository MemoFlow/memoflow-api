# development | staging | production | test
NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://localhost:27017/memoflow

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=memoflow
POSTGRES_PASSWORD=memoflow
POSTGRES_DB=memoflow
# Set true for managed Postgres that requires TLS (e.g. Neon). Local docker: false.
POSTGRES_SSL=false

# Dev-only placeholder — use a long random secret in staging/production.
# Min 32 chars (enforced by env validation).
JWT_SECRET=dev-only-change-me-to-a-32char-min-random-secret
JWT_EXPIRES_IN=15m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set true for managed TLS-only Redis (e.g. Upstash). Local docker Redis: false.
REDIS_TLS=false
# Global request rate limit (in-memory, per-instance). Optional — permissive
# defaults; auth/AI endpoints have tighter per-route caps. TTL is the window in ms.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Frontend origin allowed to open the planning WebSocket. '*' is fine for
# local dev only — set the real origin explicitly in staging/production.
WS_CORS_ORIGIN=*
# Frontend origin allowed to call the REST API (CORS). '*' is fine for local
# dev only — set the real origin explicitly in staging/production.
CORS_ORIGIN=*

# Composio is the OAuth token vault for connectors — this API only stores a
# connection reference (composio_account_id, status), never raw provider tokens.
COMPOSIO_API_KEY=composio-dev-placeholder-key
# Optional — defaults to Composio's hosted backend if unset.
COMPOSIO_BASE_URL=https://backend.composio.dev
# Comma-separated provider:authConfigId map (see ConnectorProvider allowlist).
COMPOSIO_AUTH_CONFIG_IDS=trello:ac_placeholder_trello,notion:ac_placeholder_notion,github:ac_placeholder_github
# Signs Composio's POST /connectors/webhook callbacks (webhook-id/webhook-timestamp/
# webhook-signature headers, HMAC-SHA256) — from the Composio dashboard's webhook
# subscription config. Dev-only placeholder — never commit the real value.
COMPOSIO_WEBHOOK_SECRET=composio-dev-placeholder-webhook-secret

# Base URL of the external context engine (POST target for a planning job's
# active connectors + Composio MCP references + prompt). Optional — leave
# unset to keep the planning pipeline on the built-in StubContextGatherer.
CONTEXT_ENGINE_URL=
# Sent as "Authorization: Bearer <key>" on context-engine requests when set.
CONTEXT_ENGINE_API_KEY=
# Abort the context-engine POST after this many milliseconds (defaults to
# 10000 if unset) so a hung context engine can't stall a planning job.
CONTEXT_ENGINE_TIMEOUT_MS=10000

# Roadmap item 5 (AI layer) — powers suggestion generation and the LLM
# planner. Optional: leave unset to keep both on their stub/null fallbacks
# (POST .../suggestions returns 503 "AI not configured"; planning jobs keep
# using StubLlmPlanner). Never required for boot.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5
# Defaults to 4096 if unset.
ANTHROPIC_MAX_TOKENS=4096

# RabbitMQ context-engine transport (docs/contracts/context-engine.md).
# Optional — leave unset to keep the planning pipeline on the legacy
# synchronous ContextEngineHttpClient/stub gather path (CONTEXT_ENGINE_URL
# above). Set (amqp://user:pass@host:5672/vhost, or amqps://…:5671/vhost for
# TLS) to switch planning jobs onto the async RabbitMQ request/result queue
# transport instead. Managed dev broker: CloudAMQP free tier ("Little Lemur")
# — copy the AMQP URL from the instance's details page (TLS-only, so amqps://;
# user and vhost are both the instance id). Every service on this bus (API,
# context engine, n8n) must point at the same broker instance.
# e.g. amqps://abcdefgh:password@moose.rmq.cloudamqp.com/abcdefgh
RABBITMQ_URL=
# How long (ms) a planning job may sit in "gathering" before it's failed
# with error_code CONTEXT_ENGINE_TIMEOUT. Only meaningful when RABBITMQ_URL
# is set. Defaults to 120000 (2 minutes) if unset.
CONTEXT_GATHER_TIMEOUT_MS=120000
